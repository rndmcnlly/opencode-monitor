{
  "name": "opencode-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "build:extension": "npm --prefix openchamber-extension run build",
    "check:extension": "npm --prefix openchamber-extension run check",
    "connect:openchamber": "node openchamber-extension/connect.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.15",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.0.0" },
    "contributes": {
      "panel": {
        "id": "opencode-monitor",
        "name": "Background jobs",
        "icon": "service-bell",
        "entry": "openchamber-extension/panel/index.html"
      },
      "service": {
        "entry": "openchamber-extension/service/main.js",
        "runtime": "host",
        "permissions": { "exec": ["ps"] }
      }
    }
  }
}
